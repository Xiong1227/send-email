# 复制本文件为 .env，再填入真实值（不要提交 .env）
#
# LLM：与 config.yaml 里 llm.provider 对应
# 默认 Agnes；若改成 deepseek，则必须填 DEEPSEEK_API_KEY
AGNES_API_KEY=sk-your-agnes-api-key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 邮件（QQ 邮箱 SMTP；密码处填授权码，不是登录密码）
SMTP_HOST=smtp.qq.com
# QQ 推荐 587（STARTTLS）。465（SSL）在部分网络会握手超时，脚本会自动改试另一个端口。
SMTP_PORT=587
EMAIL_FROM=from@qq.com
EMAIL_TO=to@qq.com
EMAIL_PASSWORD=your-smtp-auth-code
